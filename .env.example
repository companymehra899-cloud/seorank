# Copy this file to .env and fill in your own keys.
# Keys are read from the environment; never commit the real .env file.

# Optional. All tools already run live without a key (Google autocomplete + DuckDuckGo/Bing).
# Add a Serper.dev key for Google SERP data: https://serper.dev/api-keys
SERPER_API_KEY=your-serper-api-key-here
